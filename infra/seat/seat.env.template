# Engine environment for a hosted seat. bootstrap.sh fills the double-at placeholders into
# $SEAT_HOME/seat.env; every value is validated before it is written. No secrets live here.
# See docs/hosted-seat.md for what each variable does.

# Host networking: bind loopback, the edge connects from 127.0.0.1.
ENGINE_HOST=127.0.0.1
ENGINE_PORT=4100
ENGINE_PUBLIC_HOST=@@PUBLIC_HOST@@
ENGINE_TRUST_PROXY=1
ENGINE_TRUSTED_PROXIES=127.0.0.0/8,::1
ENGINE_STATIC_DIR=/seat/src/apps/desktop/dist
ENGINE_DATA_DIR=/seat/engine-data
# The node image ships no ffmpeg; bootstrap.sh installs a static build under cache/ (audio sources).
FFMPEG_PATH=/seat/cache/bin/ffmpeg

# First-run defaults only: once settings.json exists, the student's settings win.
UNI_SERVER_URL=@@UNI_SERVER_URL@@
OLLAMA_URL=http://127.0.0.1:11434

# Every chat role on one model. A local-model seat (4 vCPU / 8 GiB, no GPU) gets gemma4:e2b,
# the PR-31 tier for under 12 GB; a central-model seat gets gemma4:e4b, which the GPU gateway
# runs (e2b writes malformed structured output and refusal templates there).
TUTOR_MODEL=@@CHAT_MODEL@@
BRAIN_MODEL=@@CHAT_MODEL@@
VISION_MODEL=@@CHAT_MODEL@@
EMBED_MODEL=@@EMBED_MODEL@@
# The `thinking` setting a new profile starts with: false on a central-model seat (thinking
# makes structured runs crawl through the gateway), true on a local one.
ENGINE_THINKING_DEFAULT=@@THINKING_DEFAULT@@

# A seat never seeds demo profiles or a known password.
SEED_DEMO=false
NODE_ENV=production
