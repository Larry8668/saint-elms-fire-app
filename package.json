{
  "name": "saint-elms-fire-app",
  "private": true,
  "version": "0.1.0",
  "description": "Saint Elms Fire — a local-first second brain with three Socratic teachers, powered by open-weight Gemma 4.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n uni,engine,app -c magenta,cyan,yellow \"pnpm dev:uni\" \"pnpm dev:engine\" \"pnpm dev:app\"",
    "dev:uni": "pnpm --filter @sef/uni-server dev",
    "dev:engine": "pnpm --filter @sef/engine dev",
    "dev:app": "pnpm --filter @sef/desktop dev",
    "desktop": "pnpm --filter @sef/desktop tauri dev",
    "desktop:build": "pnpm --filter @sef/desktop tauri build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "doctor": "bash scripts/doctor.sh",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:status": "docker compose ps",
    "ollama:pull": "ollama pull gemma4:e4b && ollama pull embeddinggemma",
    "keys:uni": "pnpm --filter @sef/uni-server keys"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
