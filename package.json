{
  "name": "saint-elms-fire-app",
  "private": true,
  "version": "0.1.0",
  "description": "Saint Elms Fire \u2014 a local-first second brain with three Socratic teachers, powered by open-weight Gemma 4.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n uni,engine,app -c magenta,cyan,yellow \"pnpm dev:uni\" \"pnpm dev:engine\" \"pnpm dev:app\"",
    "dev:uni": "pnpm --filter @sef/uni-server dev",
    "dev:engine": "pnpm --filter @sef/engine dev",
    "dev:app": "pnpm --filter @sef/desktop dev",
    "dev:gateway": "pnpm --filter @sef/gateway dev",
    "desktop": "pnpm --filter @sef/desktop tauri dev",
    "desktop:build": "pnpm --filter @sef/desktop tauri build",
    "build": "pnpm -r build",
    "build:hosted": "pnpm --filter @sef/desktop build:portal && pnpm --filter @sef/admin build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "eval": "pnpm --filter @sef/engine eval",
    "preflight": "bash scripts/preflight.sh",
    "demo:hosted": "bash scripts/demo-hosted.sh up",
    "demo:hosted:down": "bash scripts/demo-hosted.sh down",
    "demo:hosted:status": "bash scripts/demo-hosted.sh status",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:status": "docker compose ps",
    "search:up": "docker compose up -d searxng",
    "search:down": "docker compose stop searxng",
    "store:up": "docker compose up -d --build minio minio-init",
    "store:down": "docker compose stop minio",
    "store:console": "node -e \"const u='http://127.0.0.1:'+(process.env.MINIO_CONSOLE_PORT||9001);console.log('MinIO console: '+u+' (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD, dev default sef-minio-admin)');require('node:child_process').spawn(process.platform==='darwin'?'open':process.platform==='win32'?'explorer':'xdg-open',[u],{stdio:'ignore',detached:true}).on('error',()=>{}).unref()\"",
    "store:check": "pnpm --filter @sef/engine store:check",
    "ollama:pull": "ollama pull gemma4:e4b && ollama pull embeddinggemma && ollama pull shieldgemma:2b",
    "keys:uni": "pnpm --filter @sef/uni-server keys",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.7.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
