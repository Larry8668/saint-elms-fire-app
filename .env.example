# Copy to .env. Every value is optional; these are the defaults.

# --- engine (local runtime) ---
ENGINE_PORT=4100
ENGINE_HOST=127.0.0.1
# ENGINE_DATA_DIR=./.data/engine
# Who is studying comes from sign-in; these control device sessions and demo data.
ENGINE_SESSION_HOURS=336
SEED_DEMO=true
UNI_SERVER_URL=http://localhost:4200
SEARXNG_URL=http://localhost:8888
LOG_LEVEL=info

# Models (first-run defaults; change any time in Settings)
OLLAMA_URL=http://localhost:11434
TUTOR_MODEL=gemma4:e4b
BRAIN_MODEL=gemma4:e4b
VISION_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=12288
OLLAMA_NUM_PREDICT=2048

# --- uni server ---
UNI_PORT=4200
# Compose's postgres service is private and has no published host port.
# Set UNI_DB_PASSWORD to a unique URL-safe value before deployment; the Compose fallback is local-only.
# For host-run migration commands, set UNI_DATABASE_URL to a reachable PostgreSQL URI.
# UNI_DATABASE_URL=postgresql://sef:<url-safe-password>@127.0.0.1:5432/sef_uni
# UNI_DB_PASSWORD=<unique-url-safe-password>
UNI_ISSUER=Saint Elms University
# Student tokens are long-lived so devices can sync after weeks offline; admin tokens are short.
STUDENT_TOKEN_HOURS=720
ADMIN_TOKEN_HOURS=12
# Account authentication (better-auth). Set a long unique secret before deployment; the Compose
# fallback and the dev fallback are local-only.
# BETTER_AUTH_SECRET=<at-least-32-characters>
# Public origin used in account emails and trusted-origin checks.
# UNI_PUBLIC_URL=http://localhost:4200
# Extra origins allowed for account redirects (comma-separated), e.g. a dev UI origin.
# UNI_TRUSTED_ORIGINS=http://localhost:5173
# Account email delivery. Production refuses to boot without real SMTP; development defaults to
# a loopback-only Mailpit (`docker compose --profile mail up -d`, UI at http://127.0.0.1:8025).
# MAIL_SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=Saint Elms University <no-reply@saintelms.local>
# COURSEWARE_DIR=./courseware
# KEYS_DIR=./server/uni/keys

# --- demo accounts (seeded on first boot by both the uni server and the engine) ---
# Demo only: admin@saintelms.local, ananya@, brinda@, chetna@saintelms.local share this password.
# For any real deployment set SEED_DEMO=false, VITE_DEMO_MODE=false and a private DEMO_PASSWORD (or none).
DEMO_PASSWORD=harbor-lantern
SEED_DEMO=true

# --- web search (SearXNG) ---
# Set a long random value before exposing SearXNG publicly.
SEARXNG_SECRET=change-me-for-public-deployments

# --- desktop app ---
VITE_ENGINE_URL=http://127.0.0.1:4100
# Set to false to build without demo helpers (no demo accounts or demo password in the UI).
VITE_DEMO_MODE=true
