# Copy to .env. Every value is optional; these are the defaults.

# --- engine (local runtime) ---
ENGINE_PORT=4100
ENGINE_HOST=127.0.0.1
# ENGINE_DATA_DIR=./.data/engine
# Who is studying comes from sign-in; these control device sessions and demo data.
ENGINE_SESSION_HOURS=336
UNI_SERVER_URL=http://localhost:4200
SEARXNG_URL=http://localhost:8888
LOG_LEVEL=info
# Extra origins the engine accepts browser calls from (comma-separated). Loopback Vite and
# Tauri origins are always allowed; only add an origin if the student UI is served over http(s).
# ENGINE_ALLOWED_ORIGINS=https://app.example.edu
# Hosted seat only (docs/hosted-seat.md): the published hostname, whether to honour
# X-Forwarded-* from trusted peers (loopback by default), and the built UI to serve.
# ENGINE_PUBLIC_HOST is REQUIRED for any public deployment: a public https origin in
# ENGINE_ALLOWED_ORIGINS, or ENGINE_HOST beyond loopback, without it refuses to start.
# ENGINE_PUBLIC_HOST=4100-<id>.instabox.tech
# ENGINE_TRUST_PROXY=1
# ENGINE_TRUSTED_PROXIES=127.0.0.0/8,::1
# ENGINE_STATIC_DIR=/absolute/path/to/apps/desktop/dist   (relative paths resolve from engine/)
# Direct peers (CIDRs) that count as this device, e.g. a container's bridge gateway when
# its port is published on loopback only (docker-compose sets it).
# ENGINE_DEVICE_PEERS=172.16.0.0/12

# Models (first-run defaults; change any time in Settings)
OLLAMA_URL=http://localhost:11434
TUTOR_MODEL=gemma4:e4b
BRAIN_MODEL=gemma4:e4b
VISION_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=12288
OLLAMA_NUM_PREDICT=1200

# --- uni server ---
UNI_PORT=4200
# UNI_HOST=0.0.0.0   # bind all interfaces (compose) or 127.0.0.1 (host-only dev)
# Compose's postgres service is private and has no published host port.
# Set UNI_DB_PASSWORD to a unique URL-safe value before deployment; the Compose fallback is local-only.
# For host-run migration commands, set UNI_DATABASE_URL to a reachable PostgreSQL URI.
# UNI_DATABASE_URL=postgresql://sef:<url-safe-password>@127.0.0.1:5432/sef_uni
# UNI_DB_PASSWORD=<unique-url-safe-password>
UNI_ISSUER=Saint Elms University
# Student tokens are long-lived so devices can sync after weeks offline; admin tokens are short.
STUDENT_TOKEN_HOURS=720
ADMIN_TOKEN_HOURS=12
# Account authentication (better-auth). Set a long unique secret before deployment; the Compose
# fallback and the dev fallback are local-only.
# BETTER_AUTH_SECRET=<at-least-32-characters>
# Public origin used in account emails and trusted-origin checks.
# UNI_PUBLIC_URL=http://localhost:4200
# Extra origins allowed for account redirects (comma-separated), e.g. a dev UI origin.
# UNI_TRUSTED_ORIGINS=http://localhost:5173
# Account email delivery. Production refuses to boot without real SMTP; development defaults to
# a loopback-only Mailpit (`docker compose --profile mail up -d`, UI at http://127.0.0.1:8025).
# MAIL_SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=Saint Elms University <no-reply@saintelms.local>
# Or, where SMTP ports are blocked (Render): MAIL_RESEND_API_KEY=re_... sends through Resend's HTTPS API

# COURSEWARE_DIR=./courseware
# KEYS_DIR=./server/uni/keys
# UNI_DATA_DIR=./.data/uni
# Hosted surfaces the uni serves itself; defaults resolve to the repo builds. The Docker
# `uni` target points these at image-copied output instead.
# UNI_PORTAL_DIR=./apps/desktop/dist-portal
# UNI_ADMIN_DIR=./apps/admin/dist
# Offline entitlements renew daily so a suspension stops verified access within ~a day.
ENTITLEMENT_HOURS=24
# Peer-share caps.
SHARES_PER_DAY=10
# SHARE_MAX_BYTES=10240
# SHARE_ATTACHMENT_MAX_BYTES=26214400

# --- model gateway (docs/model-gateway.md; `pnpm dev:gateway`, compose --profile gateway) ---
# GATEWAY_PORT=4300
# GATEWAY_HOST=127.0.0.1
# Workers, comma-separated. `vllm:` marks an OpenAI-only worker; `#max=N` is its concurrency.
# GATEWAY_UPSTREAMS=http://127.0.0.1:11434,vllm:https://gpu-2.example:8000#max=16
# HMAC secret shared with the session orchestrator, which mints per-VM tokens (>= 32 chars).
# GATEWAY_TOKEN_SECRET=<at-least-32-random-characters>
# Static local-dev tokens, `token[:subject]`, each >= 16 chars. Never in production.
# GATEWAY_DEV_TOKENS=<16+-char-token>:dev-student
# Bearer for the authenticated /metrics JSON (unset = /metrics always 401).
# GATEWAY_METRICS_TOKEN=<random>
# Bearer sent to workers that require one (e.g. vLLM --api-key).
# GATEWAY_UPSTREAM_TOKEN=
# GATEWAY_MODELS=gemma4:e4b,gemma4:e2b,embeddinggemma,shieldgemma:2b
# GATEWAY_UPSTREAM_MAX_INFLIGHT=4
# GATEWAY_RATE_PER_MINUTE=60
# GATEWAY_MAX_CONCURRENT_PER_SUBJECT=4
# GATEWAY_DAILY_TOKEN_BUDGET=300000
# Engines reach the gateway through PR-44's MODEL_GATEWAY_URL=<gateway>/v1 + MODEL_GATEWAY_TOKEN.

# --- demo accounts (seeded on first boot by both the uni server and the engine) ---
# DEMO ONLY. Seeding is opt-in: the engine and the desktop UI both default to no demo data —
# the out-of-the-box demo works because this file opts in. For any real deployment set
# SEED_DEMO=false and VITE_DEMO_MODE=false (or unset them) and use a private DEMO_PASSWORD or none.
# Demo only: admin@saintelms.local, ananya@, brinda@, chetna@saintelms.local share this password.
# The production/compose stack refuses to boot while this still holds the public value below.
DEMO_PASSWORD=harbor-lantern
SEED_DEMO=true

# --- web search (SearXNG) ---
# Set a long random value before exposing SearXNG publicly.
SEARXNG_SECRET=change-me-for-public-deployments

# --- desktop app ---
VITE_ENGINE_URL=http://127.0.0.1:4100
# `same-origin` builds the UI an engine serves itself (ENGINE_STATIC_DIR on a hosted seat).
# The hosted account/onboarding surfaces the app links out to (registration, device approval).
VITE_UNI_URL=http://localhost:4200
# DEMO ONLY — demo helpers are opt-in and this file opts in. Set to false (or unset) to build
# without demo helpers: no demo accounts or demo password in the UI.
VITE_DEMO_MODE=true

# --- object store (vault sync; off by default — see docs/object-store.md) ---
# The engine ignores all of this unless OBJECT_STORE_ENDPOINT and OBJECT_STORE_BUCKET are both
# set. `pnpm store:up` starts MinIO and creates the bucket and the engine key below. A host-run
# engine uses 127.0.0.1:9000; the compose engine container needs http://minio:9000 instead.
# DigitalOcean Spaces: https://<region>.digitaloceanspaces.com, region <region>, path style false.
# OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
# OBJECT_STORE_REGION=us-east-1
# OBJECT_STORE_BUCKET=sef-vaults
# OBJECT_STORE_ACCESS_KEY=sef-engine
# OBJECT_STORE_SECRET_KEY=sef-engine-local-dev-only
# OBJECT_STORE_FORCE_PATH_STYLE=true
# Vault sync proper (PR-41b) also needs the account whose profile it restores and pushes — the
# seat owner's uni account id — and, for the final flush endpoint, a random bearer (≥ 24 chars).
# VAULT_SYNC_ACCOUNT=
# SYNC_FLUSH_TOKEN=
# MinIO root login (console, bucket bootstrap) — local-only defaults; never give these to the engine.
# MINIO_ROOT_USER=sef-minio-admin
# MINIO_ROOT_PASSWORD=sef-minio-local-dev-only
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
