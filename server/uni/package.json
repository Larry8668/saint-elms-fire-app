{
  "name": "@sef/uni-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "keys": "tsx src/scripts/print-public-key.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "db:migrate": "tsx src/scripts/db-migrate.ts",
    "db:status": "tsx src/scripts/db-status.ts",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:test:integration": "node scripts/run-db-integration-tests.mjs",
    "staff:grant": "tsx src/scripts/grant-staff.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@sef/shared": "workspace:*",
    "better-auth": "1.7.7",
    "hono": "^4.10.1",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
