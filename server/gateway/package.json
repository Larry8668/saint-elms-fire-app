{
  "name": "@sef/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "token": "tsx --env-file-if-exists=../../.env src/scripts/mint-token.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --import tsx 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@sef/shared": "workspace:*",
    "hono": "^4.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
